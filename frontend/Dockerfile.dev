# Development image for the Next.js frontend.
#
# Single stage on purpose: the source is mounted over this at runtime and `next dev` handles
# rebuilding. The production image (frontend/Dockerfile) is a separate, multi-stage file.

FROM node:22-bookworm-slim

WORKDIR /app

# Installed as its own layer so a source change does not reinstall the dependency tree. At runtime
# a named volume is mounted over /app/node_modules, which is what keeps the host's macOS-built
# native binaries out of this Linux container.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development

EXPOSE 3000

# -H 0.0.0.0 matters: bound to loopback, the dev server would be unreachable from outside the
# container, including from the published port.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
