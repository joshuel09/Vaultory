# Copy to backend/.env for local development. Never commit the copy.
# Every value is read at startup; a missing required value fails fast (Constitution IV).

VAULTORY_DATABASE_URL=postgres://vaultory:vaultory_dev_password@localhost:5432/vaultory_dev?sslmode=disable
VAULTORY_LISTEN_ADDR=127.0.0.1:8080

# Image storage. "filesystem" is for development only.
VAULTORY_IMAGE_STORE=filesystem
VAULTORY_IMAGE_STORE_PATH=./.imagestore

# Development-only collector resolution. MUST be absent or "disabled" outside development:
# it accepts a dev sign-in that mints a session without any authentication.
VAULTORY_DEV_IDENTITY=enabled

# Signing key for the development session cookie. Any non-empty value works locally.
VAULTORY_SESSION_SECRET=dev-only-not-a-real-secret

# How long a replayed submission key is treated as the same submission (FR-047).
VAULTORY_IDEMPOTENCY_WINDOW=24h
